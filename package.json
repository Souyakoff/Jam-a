{
  "name": "jam-a-browser",
  "productName": "Jam-a",
  "version": "0.1.0",
  "description": "Un navigateur open source, sans pub, pensé pour les devs et les débutants.",
  "main": "dist/main.js",
  "author": "Souyakoff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Souyakoff/Jam-a.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "watch": "tsc --watch",
    "icon": "electron scripts/render-icon.js",
    "dist": "npm run build && electron-builder --win"
  },
  "keywords": [
    "browser",
    "electron",
    "adblock",
    "developer-tools"
  ],
  "build": {
    "appId": "io.github.souyakoff.jama",
    "productName": "Jam-a",
    "copyright": "Copyright © 2026 Jam<a contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jam-a",
      "uninstallDisplayName": "Jam<a",
      "artifactName": "Jam-a-Setup-${version}.${ext}",
      "installerLanguages": ["fr_FR"],
      "language": "1036"
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3"
  }
}
