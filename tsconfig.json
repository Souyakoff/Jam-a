{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src"]
}
